# Public hostname configured in Nginx Proxy Manager.
APP_DOMAIN=smart_supply_dispenser.kubits.org

# Listen on the Docker host so Nginx Proxy Manager can reach the application.
# Restrict BIND_ADDRESS to a private/LAN IP if the host firewall is not managing access.
BIND_ADDRESS=0.0.0.0
APP_PORT=3000

# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin

# Generate with: node -e "console.log(require('bcryptjs').hashSync('change-me', 12))"
# Keep the single quotes: they prevent Docker Compose from expanding bcrypt '$' characters.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-a-valid-bcrypt-hash'

# Generate each independently. Never reuse AUTH_SECRET.
DEVICE_SHARED_SECRET=replace-with-a-device-secret
PII_ENCRYPTION_KEY=replace-with-a-pii-encryption-secret
PII_LOOKUP_KEY=replace-with-a-different-pii-lookup-secret

# Optional: when empty, images are stored in the Docker image_uploads volume.
# Set this only when image storage should use Vercel Blob instead.
BLOB_READ_WRITE_TOKEN=

# The current prototype store is in memory. true adds the demo dispenser after each restart.
SEED_DEMO_DATA=false

NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
