DATABASE_URL=postgres://user:password@localhost:5432/smart_supply_dispenser
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('change-me', 12))"
ADMIN_PASSWORD_HASH=$2a$12$replace-with-a-bcrypt-hash
DEVICE_SHARED_SECRET=replace-with-a-device-secret
# 32-byte base64 key. Generate with: openssl rand -base64 32
PII_ENCRYPTION_KEY=replace-with-32-byte-base64-key
PII_LOOKUP_KEY=replace-with-a-different-lookup-key
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_APP_URL=http://localhost:3000
SEED_DEMO_DATA=false
